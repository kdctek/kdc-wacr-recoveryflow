{
	"name": "kdctek/kdc-wacr-recoveryflow",
	"description": "RecoveryFlow by WA.cr — a conversion recovery engine for WordPress. Composer is a development dependency only; the shipped plugin needs no vendor directory.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"php-stubs/woocommerce-stubs": "^9.0 || ^10.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.10",
		"phpunit/phpunit": "^9.6",
		"squizlabs/php_codesniffer": "^3.9",
		"szepeviktor/phpstan-wordpress": "^1.3",
		"wp-coding-standards/wpcs": "^3.1",
		"yoast/phpunit-polyfills": "^2.0"
	},
	"autoload-dev": {
		"psr-4": {
			"WAcr\\RecoveryFlow\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"lint:fix": "phpcbf",
		"analyse": "phpstan analyse --memory-limit=1G",
		"test": "@test:unit",
		"test:unit": "phpunit --testsuite unit",
		"test:integration": "phpunit --testsuite integration",
		"test:security": "phpunit --testsuite security",
		"test:all": "phpunit"
	}
}
