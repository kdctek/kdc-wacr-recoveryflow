#: src/Core/Health.php:247
#: src/Core/Health.php:263
msgid "Email reminders"
msgstr ""

#: src/Admin/Settings/Schema.php:355
msgid "Send reminders by email"
msgstr ""

#: src/Admin/Settings/Schema.php:356
msgid "Off by default. Email passes two gates: this switch, and the compliance settings above. Turning this on while anything above is unsettled changes nothing -- no email is sent either way."
msgstr ""

